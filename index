    <!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Anas Mohamed | Portfolio</title>

<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

<style>

*{
  margin:0;
  padding:0;
  box-sizing:border-box;
  font-family:'Poppins',sans-serif;
}

body{
  background: radial-gradient(circle at top,#0f172a,#020617);
  color:#e2e8f0;
  overflow-x:hidden;
}

/* HERO */

.hero{
  height:100vh;
  display:flex;
  flex-direction:column;
  justify-content:center;
  align-items:center;
  text-align:center;
}

.hero img{
  width:160px;
  height:160px;
  border-radius:50%;
  border:4px solid #38bdf8;
  margin-bottom:20px;
  animation:float 4s ease-in-out infinite;
}

.hero h1{
  font-size:3rem;
  margin-bottom:10px;
}

.typing{
  color:#38bdf8;
  border-right:2px solid #38bdf8;
  white-space:nowrap;
  overflow:hidden;
  width:0;
  animation:typing 3s steps(20) forwards, blink .7s infinite;
}

/* CONTAINER */

.container{
  width:90%;
  max-width:1100px;
  margin:auto;
  padding-bottom:60px;
}

/* CARD */

.card{
  background:rgba(255,255,255,0.05);
  border:1px solid rgba(255,255,255,0.08);
  padding:25px;
  border-radius:16px;
  margin-top:25px;
  backdrop-filter:blur(10px);
  opacity:0;
  transform:translateY(40px);
  transition:0.8s;
}

.card.show{
  opacity:1;
  transform:translateY(0);
}

.card:hover{
  transform:translateY(-6px);
}

/* SKILLS */

.skills{
  display:flex;
  flex-wrap:wrap;
  gap:10px;
}

.skill{
  background:#38bdf8;
  color:#000;
  padding:8px 14px;
  border-radius:20px;
  font-weight:500;
  transition:0.3s;
}

.skill:hover{
  transform:scale(1.1);
}

/* EDUCATION */

.edu-item{
  margin-bottom:10px;
  padding-left:10px;
  border-left:3px solid #38bdf8;
}

/* ACCOUNTS */

.accounts{
  display:grid;
  gap:15px;
}

.account{
  background:rgba(255,255,255,0.05);
  padding:15px;
  border-radius:12px;
  border:1px solid rgba(255,255,255,0.08);
  transition:0.3s;
}

.account:hover{
  transform:translateY(-4px);
}

.account span{
  display:block;
  color:#38bdf8;
  font-weight:600;
  margin-bottom:5px;
}

.account p{
  font-size:14px;
  margin-bottom:8px;
}

.account button,
.account a{
  padding:6px 12px;
  background:#38bdf8;
  color:#000;
  border:none;
  border-radius:8px;
  cursor:pointer;
  font-weight:600;
  text-decoration:none;
  display:inline-block;
}

/* ANIMATIONS */

@keyframes float{
  0%,100%{transform:translateY(0);}
  50%{transform:translateY(-12px);}
}

@keyframes typing{
  from{width:0;}
  to{width:220px;}
}

@keyframes blink{
  50%{border-color:transparent;}
}

</style>
</head>

<body>

<!-- HERO -->
<div class="hero">
  <img src="your-image.jpg">
  <h1>Anas Mohamed</h1>
  <div class="typing">Front-End Developer</div>
</div>

<div class="container">

  <!-- ABOUT -->
  <div class="card">
    <h2>About Me</h2>
    <p>
      Motivated Front-End Developer with a strong foundation in web development and programming concepts. Certified by STEM and skilled in HTML, CSS, JavaScript, and C++. Passionate about creating responsive and user-friendly web applications. Currently pursuing a Bachelor’s degree in Food Safety at Suez Canal University while continuously developing technical and problem-solving skills.
    </p>
  </div>

  <!-- EDUCATION -->
  <div class="card">
    <h2>Education</h2>

    <div class="edu-item">Bachelor’s Degree in Agriculture – Food Safety Department</div>
    <div class="edu-item">2026 - Data Science Certificate</div>

  </div>

  <!-- SKILLS -->
  <div class="card">
    <h2>Skills</h2>

    <div class="skills">
      <div class="skill">HTML</div>
      <div class="skill">CSS</div>
      <div class="skill">JavaScript</div>
      <div class="skill">c++</div>
      <div class="skill">excel</div>
      <div class="skill">word</div>
    </div>

  </div>

  <!-- ACCOUNTS -->
  <div class="card">
    <h2>My Accounts</h2>

    <div class="accounts">

      <div class="account">
        <span>📧 Primary Email</span>
        <p>anasmohamed.2024@icloud.com</p>
        <button onclick="copyText('anasmohamed.2024@icloud.com')">Copy</button>
      </div>

      <div class="account">
        <span>phone</span>
        <p>01278089381</p>
        <button onclick="copyText('01278089381')">Copy</button>
      </div>

      <div class="account">
        <span>💻 GitHub</span>
        <p>anasmohamed171285</p>
        <a href="https://github.com/anasmohamed171285" target="_blank">Open</a>
      </div>

      <div class="account">
        <span>🔗 LinkedIn</span>
        <p>Profile</p>
        <a href="https://www.linkedin.com" target="_blank">Open</a>
      </div>

    </div>

  </div>

</div>

<script>

// scroll animation
const cards = document.querySelectorAll(".card");

window.addEventListener("scroll", () => {
  cards.forEach(card => {
    const offset = card.offsetTop - 500;
    if(window.scrollY > offset){
      card.classList.add("show");
    }
  });
});

// copy email
function copyText(text){
  navigator.clipboard.writeText(text);
  alert("Copied: " + text);
}

</script>

</body>
</html>